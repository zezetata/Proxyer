# ------------------------------------------------------------------------------
# 2. Exact Domains & Third-Party Integrations (精确域名、CDN 子域名与第三方依赖)
# ------------------------------------------------------------------------------
DOMAIN,status.discord.com
DOMAIN,support.discord.com
DOMAIN,media.discordapp.net
DOMAIN,images-ext-1.discordapp.net
DOMAIN,images-ext-2.discordapp.net

# ------------------------------------------------------------------------------
# 3. Process & Client User-Agent Rules (macOS / iOS / Windows 客户端进程与 UA 识别)
# ------------------------------------------------------------------------------
USER-AGENT,Discord*
USER-AGENT,*Discord*
PROCESS-NAME,Discord
PROCESS-NAME,Discord Helper
PROCESS-NAME,Discord Helper (Renderer)
PROCESS-NAME,Discord Helper (GPU)

# ------------------------------------------------------------------------------
# 4. Discord Official ASNs & Core Anycast IP Blocks (官方自治系统号与核心 IP 段)
# ------------------------------------------------------------------------------
IP-CIDR,34.0.0.0/9,no-resolve
IP-CIDR,35.184.0.0/13,no-resolve
IP-CIDR,66.22.192.0/18,no-resolve
IP-CIDR6,2602:fbaf::/32,no-resolve
IP-CIDR6,2a03:b0c0::/32,no-resolve
IP-ASN,14757,no-resolve
IP-ASN,25838,no-resolve
